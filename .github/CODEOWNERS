# Paths that need a human approval before merge. Enforced by the `main` ruleset
# (require_code_owner_review). Everything not listed here can merge on green gates.
#
# Keep in sync with policy/risk-tiers.toml ([t2] guardrails, human_gated, high_risk).
# Only people are owners. An agent's GitHub App can never be one.
# `scripts/init.sh` fills in the owner placeholder below. Product paths belong to the director(s);
# for the other paths you may list any human on the project.

# Product decisions: specs, sprints, product documents.
/docs/specs/        @DIRECTOR_LOGIN
/docs/sprints/      @DIRECTOR_LOGIN
/docs/product/      @DIRECTOR_LOGIN

# The guardrails themselves.
/.github/           @DIRECTOR_LOGIN
/policy/            @DIRECTOR_LOGIN
/tools/             @DIRECTOR_LOGIN
/bin/               @DIRECTOR_LOGIN
/scripts/           @DIRECTOR_LOGIN
/sandbox/           @DIRECTOR_LOGIN
/prompts/           @DIRECTOR_LOGIN
/.claude/           @DIRECTOR_LOGIN
/codex/             @DIRECTOR_LOGIN
/AGENTS.md          @DIRECTOR_LOGIN
/CLAUDE.md          @DIRECTOR_LOGIN
/Makefile           @DIRECTOR_LOGIN
/.gitleaks.toml     @DIRECTOR_LOGIN
/.gitleaksignore    @DIRECTOR_LOGIN
/.semgrepignore     @DIRECTOR_LOGIN
/.semgrep.yml       @DIRECTOR_LOGIN
/.semgrep/          @DIRECTOR_LOGIN
/.gitattributes     @DIRECTOR_LOGIN

# Dependencies: manifests and lock files, anywhere in the tree.
package.json        @DIRECTOR_LOGIN
package-lock.json   @DIRECTOR_LOGIN
pnpm-lock.yaml      @DIRECTOR_LOGIN
yarn.lock           @DIRECTOR_LOGIN
pyproject.toml      @DIRECTOR_LOGIN
uv.lock             @DIRECTOR_LOGIN
poetry.lock         @DIRECTOR_LOGIN
requirements*.txt   @DIRECTOR_LOGIN
go.mod              @DIRECTOR_LOGIN
go.sum              @DIRECTOR_LOGIN
Cargo.toml          @DIRECTOR_LOGIN
Cargo.lock          @DIRECTOR_LOGIN
Gemfile             @DIRECTOR_LOGIN
Gemfile.lock        @DIRECTOR_LOGIN

# High-risk code. Adjust once the code layout exists.
**/auth/**          @DIRECTOR_LOGIN
**/payments/**      @DIRECTOR_LOGIN
**/billing/**       @DIRECTOR_LOGIN
**/migrations/**    @DIRECTOR_LOGIN
/infra/             @DIRECTOR_LOGIN
