<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Starts the agent sandbox VM at login. Replace PROJECT_DIR with the absolute project path. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.agent-sandbox.vm</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>PROJECT_DIR/sandbox/vm.sh up</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/agent-sandbox-vm.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/agent-sandbox-vm.log</string>
</dict>
</plist>
