#!/usr/bin/env bash
# gh inside the sandbox VM, acting as this developer's agent GitHub App.
#
# App tokens last an hour, so a token exported once would die in the middle of a
# long session. This wrapper asks for a token on every call (agentctl caches it
# until shortly before it expires). Put this directory first in PATH.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
real=""
IFS=: read -ra dirs <<< "$PATH"
for dir in "${dirs[@]}"; do
  if [ "$dir" != "$here" ] && [ -x "$dir/gh" ]; then real="$dir/gh"; break; fi
done
[ -n "$real" ] || { echo "gh is not installed" >&2; exit 127; }
token="$("$here/../../bin/agentctl" app-token)" || { echo "could not get a token for the agent GitHub App" >&2; exit 1; }
GH_TOKEN="$token" exec "$real" "$@"
